{
  "schemaVersion": "mia.plugin/1",
  "id": "builtin.timer",
  "version": "1.0.0",
  "name": "Таймер",
  "listing": {
    "description": "Несколько таймеров голосом и в чате, плитка с обратным отсчётом",
    "category": "utilities",
    "author": "Mia"
  },
  "server": {
    "kind": "builtin",
    "module": "app.plugins.builtin.timer.server"
  },
  "skills": [
    "SKILL.md"
  ],
  "tools": {
    "start": {
      "risk": "write_reversible",
      "voice": true
    },
    "get": {
      "risk": "read",
      "voice": true
    },
    "pause": {
      "risk": "write_reversible",
      "voice": true
    },
    "resume": {
      "risk": "write_reversible",
      "voice": true
    },
    "cancel": {
      "risk": "write_reversible",
      "voice": true
    }
  },
  "requires": {
    "deviceTools": [
      "device.alarm.set"
    ],
    "deviceCapabilities": [
      {
        "capability": "alarm.clock",
        "description": "По вашей просьбе дублирует таймер будильником в «Часах» телефона",
        "optional": true
      }
    ]
  },
  "whereItRuns": {
    "cloud": "Таймеры считает и запускает сервер Mia; плитка с обратным отсчётом обновляется из облака.",
    "device": "Только по вашей просьбе таймер можно продублировать будильником в «Часах» телефона."
  },
  "surfaces": {
    "tiles": [
      {
        "id": "active-timers",
        "title": "Таймеры",
        "resourceUri": "ui://builtin.timer/tile",
        "sizes": [
          "1x1",
          "2x1"
        ],
        "mobile": "card",
        "refresh": {
          "tool": "get",
          "everySeconds": 30
        }
      }
    ]
  },
  "permissions": {
    "network": [],
    "llm": {
      "viaHost": false
    },
    "memory": [],
    "notify": true,
    "schedules": true
  }
}
