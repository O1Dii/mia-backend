{
  "device_id": "a1b2c3d4-e5f6-4789-8abc-def012345678",
  "platform": "android",
  "app_version": "0.1.0",
  "tools": [
    {
      "name": "device.contacts.search",
      "description": "Find phone contacts by name (e.g. Яна). Returns matching display names only; nothing from the contacts is stored on the server. Asks the user for contacts access on first use.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "phone_count": {
                  "type": "integer"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        }
      },
      "risk": "read",
      "voice": true,
      "requires_unlocked": true,
      "timeout_ms": 20000
    },
    {
      "name": "device.alarm.set",
      "description": "Set an Android alarm at an exact time within the next 24 hours. Pass `at` as an RFC 3339 date-time with the user's UTC offset.",
      "input_schema": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "at"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer"
          },
          "minute": {
            "type": "integer"
          },
          "verified": {
            "type": "boolean"
          },
          "zone": {
            "type": "string"
          }
        }
      },
      "risk": "write_reversible",
      "voice": true,
      "requires_unlocked": false,
      "timeout_ms": 5000
    },
    {
      "name": "device.app.open",
      "description": "Open an installed Android app by its name (e.g. Telegram, Камера) or package id.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "package": {
            "type": "string",
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "risk": "write_reversible",
      "voice": true,
      "requires_unlocked": true,
      "timeout_ms": 5000
    },
    {
      "name": "telegram.handoff",
      "description": "Open Telegram with a ready message text for a contact (by contact_name from the phone's contacts, or by Telegram username). The user presses send; nothing is sent automatically.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "contact_name": {
            "type": "string",
            "maxLength": 100
          },
          "username": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "risk": "write_reversible",
      "voice": true,
      "requires_unlocked": true,
      "timeout_ms": 25000
    }
  ]
}