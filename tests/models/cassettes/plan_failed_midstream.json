{
 "name": "plan_failed_midstream",
 "note": "Text then failure: must not fail over silently.",
 "interactions": [
  {
   "request": {
    "method": "POST",
    "url": "https://api.openai.com/v1/responses",
    "forbid_body_keys": [
     "temperature",
     "max_output_tokens",
     "previous_response_id",
     "metadata",
     "user"
    ]
   },
   "response": {
    "status": 200,
    "headers": {},
    "events": [
     {
      "event": "response.output_text.delta",
      "data": {
       "type": "response.output_text.delta",
       "delta": "partial"
      }
     },
     {
      "event": "response.failed",
      "data": {
       "type": "response.failed",
       "response": {
        "status": "failed",
        "error": {
         "code": "server_error",
         "message": "UPSTREAM-BOOM-TEXT"
        }
       }
      }
     }
    ]
   }
  }
 ]
}
