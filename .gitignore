# Secret-bearing local configuration. Keep examples trackable.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Private keys and local credentials.
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json

# Python.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# IDE and operating-system files.
.idea/
.vscode/
.DS_Store

# Local reports and runtime output.
.coverage
htmlcov/
coverage.xml
*.log
tmp/
