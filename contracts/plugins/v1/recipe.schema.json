{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^community\\.[a-z0-9-]{2,48}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "runtime": {
      "type": "string",
      "const": "prompt"
    },
    "permissions": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "ai.generate"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 8000,
      "pattern": "\\{\\{input\\}\\}"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "author",
    "runtime",
    "permissions",
    "prompt"
  ],
  "additionalProperties": false,
  "$id": "https://mia.local/contracts/plugins/v1/recipe.schema.json",
  "title": "MIA text recipe v1"
}
