{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^community\\.[a-z0-9-]{2,48}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "skill": {
      "type": "string",
      "minLength": 20,
      "maxLength": 6000
    },
    "permissions": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "state.read",
          "state.write",
          "ai.generate"
        ]
      }
    },
    "actions": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,23}$"
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                },
                "description": {
                  "default": "",
                  "type": "string",
                  "maxLength": 300
                },
                "maxLength": {
                  "default": 1000,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16000
                },
                "minimum": {
                  "default": 0,
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 9007199254740991
                },
                "maximum": {
                  "default": 1000000,
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 1000000
                }
              },
              "required": [
                "type",
                "description",
                "maxLength",
                "minimum",
                "maximum"
              ],
              "additionalProperties": false
            }
          },
          "effect": {
            "type": "string",
            "enum": [
              "state.patch",
              "model.prompt"
            ]
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "description",
          "inputs",
          "effect"
        ],
        "additionalProperties": false
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "type": {
          "default": "fields",
          "type": "string",
          "enum": [
            "fields",
            "html"
          ]
        },
        "fields": {
          "default": [],
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "html": {
          "default": "",
          "type": "string",
          "maxLength": 24000
        }
      },
      "required": [
        "type",
        "fields",
        "html"
      ],
      "additionalProperties": false
    },
    "downloads": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "web",
              "android",
              "ios",
              "desktop"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https:\\/\\/[^\\s]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "platform",
          "url",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "author",
    "skill",
    "permissions",
    "actions",
    "view",
    "downloads"
  ],
  "additionalProperties": false,
  "$id": "https://mia.local/contracts/plugins/v2/application.schema.json",
  "title": "MIA application v2 — skill, actions, view, downloads"
}
