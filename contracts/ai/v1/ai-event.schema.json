{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mia.local/ai/v1/ai-event.schema.json",
  "title": "MIA normalized AIEvent v1",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "eventBase": {
      "type": "object",
      "required": ["v", "type", "event_id", "seq", "at", "payload"],
      "properties": {
        "v": { "const": 1 },
        "type": { "type": "string" },
        "event_id": { "$ref": "#/$defs/uuid" },
        "turn_id": { "$ref": "#/$defs/uuid" },
        "response_id": { "$ref": "#/$defs/uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "at": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      }
    },
    "textDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1 } }
    },
    "transcriptDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
      }
    },
    "transcriptFinal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "oneOf": [
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "text.delta" },
            "payload": { "$ref": "#/$defs/textDelta" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id"],
          "properties": {
            "type": { "const": "transcript.input.delta" },
            "payload": { "$ref": "#/$defs/transcriptDelta" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id"],
          "properties": {
            "type": { "const": "transcript.input.final" },
            "payload": { "$ref": "#/$defs/transcriptFinal" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "transcript.output.delta" },
            "payload": { "$ref": "#/$defs/transcriptDelta" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "transcript.output.final" },
            "payload": { "$ref": "#/$defs/transcriptFinal" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "audio.delta" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["encoding", "sample_rate_hz", "channels", "audio_base64"],
              "properties": {
                "encoding": { "const": "pcm_s16le" },
                "sample_rate_hz": { "type": "integer", "enum": [16000, 24000] },
                "channels": { "const": 1 },
                "audio_base64": { "type": "string", "contentEncoding": "base64" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "tool.call.requested" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["call_id", "name", "arguments", "risk", "requires_confirmation"],
              "properties": {
                "call_id": { "$ref": "#/$defs/uuid" },
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" },
                "arguments": { "type": "object" },
                "risk": { "type": "string", "enum": ["read", "write", "sensitive"] },
                "requires_confirmation": { "type": "boolean" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "tool.call.cancelled" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["call_id", "reason"],
              "properties": {
                "call_id": { "$ref": "#/$defs/uuid" },
                "reason": { "type": "string", "enum": ["response_cancelled", "provider_cancelled", "policy_denied", "session_closed"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "response.started" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["modalities"],
              "properties": {
                "modalities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "enum": ["text", "audio"] }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "response.completed" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["finish_reason"],
              "properties": {
                "finish_reason": { "type": "string", "enum": ["stop", "max_output", "tool_result", "content_filter"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "required": ["turn_id", "response_id"],
          "properties": {
            "type": { "const": "response.interrupted" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason"],
              "properties": {
                "reason": { "type": "string", "enum": ["barge_in", "user_request", "disconnect", "provider_cancelled"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "usage.reported" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider_alias", "input_tokens", "output_tokens", "input_audio_ms", "output_audio_ms"],
              "properties": {
                "provider_alias": { "type": "string", "minLength": 1 },
                "model_alias": { "type": "string", "minLength": 1 },
                "input_tokens": { "type": "integer", "minimum": 0 },
                "output_tokens": { "type": "integer", "minimum": 0 },
                "input_audio_ms": { "type": "integer", "minimum": 0 },
                "output_audio_ms": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "provider.error" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "retryable"],
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "provider_unavailable",
                    "provider_timeout",
                    "provider_rate_limited",
                    "provider_invalid_response",
                    "provider_session_expired",
                    "provider_cancelled",
                    "provider_internal_error"
                  ]
                },
                "message": { "type": "string", "minLength": 1, "maxLength": 500 },
                "retryable": { "type": "boolean" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ]
}
