{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mia.local/errors/v1/error-codes.schema.json",
  "title": "MIA public error code registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "http_status", "retryable", "public_message"],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "http_status": {
        "type": "integer",
        "minimum": 400,
        "maximum": 599
      },
      "retryable": { "type": "boolean" },
      "public_message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    }
  }
}
