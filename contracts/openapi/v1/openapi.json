{
  "openapi": "3.1.0",
  "info": {
    "title": "MIA REST API",
    "version": "1.0.0",
    "description": "Provider-neutral REST and SSE contract for the MIA PoC. The realtime WebSocket control protocol is defined under contracts/realtime/v1."
  },
  "servers": [
    { "url": "http://localhost:8000", "description": "Local development" }
  ],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "Auth" },
    { "name": "Conversations" },
    { "name": "Realtime" },
    { "name": "Tools" },
    { "name": "Health" }
  ],
  "paths": {
    "/v1/auth/google/nonce": {
      "post": {
        "tags": ["Auth"],
        "operationId": "createGoogleAuthNonce",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "201": {
            "description": "One-time nonce created",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthNonce" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/auth/google": {
      "post": {
        "tags": ["Auth"],
        "operationId": "exchangeGoogleIdToken",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GoogleAuthRequest" } } }
        },
        "responses": {
          "200": {
            "description": "MIA session issued",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthSession" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "operationId": "refreshSession",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Rotated MIA session",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthSession" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "operationId": "logout",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } }
        },
        "responses": {
          "204": {
            "description": "Session revoked",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": ["Auth"],
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/conversations": {
      "post": {
        "tags": ["Conversations"],
        "operationId": "createConversation",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateConversationRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Conversation created",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conversation" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "tags": ["Conversations"],
        "operationId": "listConversations",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated conversations",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConversationPage" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/conversations/{conversation_id}": {
      "parameters": [{ "$ref": "#/components/parameters/ConversationId" }],
      "get": {
        "tags": ["Conversations"],
        "operationId": "getConversation",
        "responses": {
          "200": {
            "description": "Conversation",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conversation" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Conversations"],
        "operationId": "updateConversation",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateConversationRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Conversation updated",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Conversation" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Conversations"],
        "operationId": "deleteConversation",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "204": {
            "description": "Conversation deleted",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/conversations/{conversation_id}/entries": {
      "get": {
        "tags": ["Conversations"],
        "operationId": "listConversationEntries",
        "parameters": [
          { "$ref": "#/components/parameters/ConversationId" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated entries",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EntryPage" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/conversations/{conversation_id}/messages:stream": {
      "post": {
        "tags": ["Conversations"],
        "operationId": "streamMessage",
        "parameters": [
          { "$ref": "#/components/parameters/ConversationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendMessageRequest" } } }
        },
        "responses": {
          "200": {
            "description": "SSE stream; each data field is a StreamEvent JSON object",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "text/event-stream": { "schema": { "type": "string" } } },
            "x-sse-event-types": ["message.delta", "tool.call.started", "tool.call.completed", "message.completed", "error"],
            "x-sse-data-schema": { "$ref": "#/components/schemas/ConversationStreamEvent" }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/realtime/sessions": {
      "post": {
        "tags": ["Realtime"],
        "operationId": "createRealtimeSession",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRealtimeSessionRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Short-lived realtime session created",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RealtimeSession" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/realtime/sessions/{session_id}": {
      "delete": {
        "tags": ["Realtime"],
        "operationId": "closeRealtimeSession",
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "204": {
            "description": "Realtime session closed",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/tool-calls/{tool_call_id}/confirm": {
      "post": {
        "tags": ["Tools"],
        "operationId": "confirmToolCall",
        "parameters": [
          { "$ref": "#/components/parameters/ToolCallId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Tool call confirmed",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ToolCall" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/tool-calls/{tool_call_id}/reject": {
      "post": {
        "tags": ["Tools"],
        "operationId": "rejectToolCall",
        "parameters": [
          { "$ref": "#/components/parameters/ToolCallId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Tool call rejected",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ToolCall" } } }
          },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": ["Health"],
        "operationId": "getLiveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["Health"],
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Required dependencies are ready",
            "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "headers": {
      "RequestId": {
        "description": "Opaque correlation identifier",
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Unique per user, endpoint, and canonical mutation request",
        "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
      },
      "ConversationId": {
        "name": "conversation_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "SessionId": {
        "name": "session_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ToolCallId": {
        "name": "tool_call_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "Error": {
        "description": "Stable public error envelope",
        "headers": { "X-Request-ID": { "$ref": "#/components/headers/RequestId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "validation_error",
          "authentication_required",
          "invalid_credentials",
          "token_expired",
          "permission_denied",
          "resource_not_found",
          "conflict",
          "idempotency_conflict",
          "rate_limit_exceeded",
          "conversation_not_found",
          "turn_not_found",
          "realtime_session_not_found",
          "realtime_protocol_unsupported",
          "realtime_invalid_event",
          "realtime_backpressure",
          "realtime_provider_unavailable",
          "provider_timeout",
          "tool_not_found",
          "tool_invalid_arguments",
          "tool_permission_denied",
          "tool_confirmation_required",
          "tool_execution_failed",
          "internal_error",
          "service_unavailable"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "request_id", "retryable"],
            "properties": {
              "code": { "$ref": "#/components/schemas/ErrorCode" },
              "message": { "type": "string", "minLength": 1, "maxLength": 500 },
              "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "retryable": { "type": "boolean" },
              "details": { "type": "object", "additionalProperties": true }
            }
          }
        }
      },
      "AuthNonce": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nonce", "expires_at"],
        "properties": {
          "nonce": { "type": "string", "minLength": 32, "maxLength": 512 },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "app_version"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "platform": { "const": "android" },
          "app_version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "device_name": { "type": "string", "maxLength": 128 },
          "capabilities": { "type": "object", "additionalProperties": true }
        }
      },
      "GoogleAuthRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id_token", "nonce", "device"],
        "properties": {
          "id_token": { "type": "string", "minLength": 1 },
          "nonce": { "type": "string", "minLength": 32, "maxLength": 512 },
          "device": { "$ref": "#/components/schemas/Device" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refresh_token"],
        "properties": { "refresh_token": { "type": "string", "minLength": 32 } }
      },
      "AuthSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["access_token", "refresh_token", "token_type", "expires_in", "user"],
        "properties": {
          "access_token": { "type": "string", "minLength": 1 },
          "refresh_token": { "type": "string", "minLength": 32 },
          "token_type": { "const": "Bearer" },
          "expires_in": { "type": "integer", "minimum": 1 },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "email", "email_verified", "locale", "timezone", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "email_verified": { "type": "boolean" },
          "display_name": { "type": ["string", "null"], "maxLength": 160 },
          "avatar_url": { "type": ["string", "null"], "format": "uri" },
          "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
          "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "title": { "type": ["string", "null"], "maxLength": 200 } }
      },
      "UpdateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": { "type": ["string", "null"], "maxLength": 200 },
          "archived": { "type": "boolean" }
        }
      },
      "Conversation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "created_at", "updated_at", "archived_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": ["string", "null"], "maxLength": 200 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "archived_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "ConversationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Conversation" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "Entry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "conversation_id", "turn_id", "sequence", "role", "kind", "modality", "content", "delivery_status", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "conversation_id": { "type": "string", "format": "uuid" },
          "turn_id": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "minimum": 1 },
          "role": { "type": "string", "enum": ["user", "assistant", "tool", "system"] },
          "kind": { "type": "string", "enum": ["text", "transcript", "tool_call", "tool_result", "artifact_ref"] },
          "modality": { "type": "string", "enum": ["text", "audio"] },
          "content": { "type": "object", "additionalProperties": true },
          "delivery_status": { "type": "string", "enum": ["pending", "streaming", "delivered", "interrupted", "failed"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "EntryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Entry" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 32000 } }
      },
      "ConversationStreamEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["v", "type", "event_id", "turn_id", "response_id", "seq", "at", "payload"],
        "properties": {
          "v": { "const": 1 },
          "type": {
            "type": "string",
            "enum": ["message.delta", "tool.call.started", "tool.call.completed", "message.completed", "error"]
          },
          "event_id": { "type": "string", "format": "uuid" },
          "turn_id": { "type": "string", "format": "uuid" },
          "response_id": { "type": "string", "format": "uuid" },
          "seq": { "type": "integer", "minimum": 1 },
          "at": { "type": "string", "format": "date-time" },
          "payload": { "type": "object", "additionalProperties": true }
        }
      },
      "AudioFormat": {
        "type": "object",
        "additionalProperties": false,
        "required": ["encoding", "sample_rate_hz", "channels"],
        "properties": {
          "encoding": { "const": "pcm_s16le" },
          "sample_rate_hz": { "type": "integer", "enum": [16000, 24000] },
          "channels": { "const": 1 }
        }
      },
      "CreateRealtimeSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversation_id", "locale", "input_audio", "output_audio"],
        "properties": {
          "conversation_id": { "type": "string", "format": "uuid" },
          "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
          "input_audio": { "$ref": "#/components/schemas/AudioFormat" },
          "output_audio": { "$ref": "#/components/schemas/AudioFormat" }
        }
      },
      "RealtimeSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "websocket_url", "protocol_version", "expires_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "websocket_url": { "type": "string", "format": "uri" },
          "protocol_version": { "const": 1 },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "ToolCall": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "turn_id", "name", "risk", "state", "requires_confirmation"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "turn_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" },
          "risk": { "type": "string", "enum": ["read", "write", "sensitive"] },
          "state": { "type": "string", "enum": ["proposed", "waiting_confirmation", "running", "succeeded", "failed", "cancelled"] },
          "requires_confirmation": { "type": "boolean" }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok", "degraded"] } }
      }
    }
  },
  "x-mia-websocket": {
    "path": "/v1/realtime",
    "protocol": "contracts/realtime/v1",
    "authentication": "Authorization: Bearer <access token>"
  }
}
