# Local development uses the fake provider by default. Do not place real values in this file.
APP_ENV=development
LOG_LEVEL=INFO
AI_PROVIDER=fake
DATABASE_URL=postgresql+asyncpg://mia:mia-local-only@localhost:5432/mia
REDIS_URL=redis://localhost:6379/0
# GEMINI_API_KEY=
# Gemini 3.x rejects MIA's manual tool loop: it requires the model's
# thought_signature to be echoed back with the functionCall part, and the
# provider-neutral ToolFeedback does not carry one. Use a 2.5 text model
# until that passthrough exists. See docs/implementation/handoffs/S13-R1.md.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# Only the 2.5 native-audio family is verified against the S16 adapter.
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_REQUEST_TIMEOUT_SECONDS=30
# GOOGLE_CLIENT_ID=
# AUTH_JWT_SECRET=
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_NONCE_TTL_SECONDS=300
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_NONCE_RATE_LIMIT=10
# AUTH_EXCHANGE_RATE_LIMIT=10
# AUTH_REFRESH_RATE_LIMIT=30
# AUTH_AUTHENTICATED_RATE_LIMIT=120
# VOICE_ENABLED=true
# TEXT_ENABLED=true
# MAX_LIVE_SESSION_SECONDS=900
# MAX_DAILY_TEXT_TURNS=100
# MAX_DAILY_LIVE_SESSIONS=20
# MAX_ACTIVE_LIVE_SESSIONS_PER_USER=1
# PROVIDER_FAILURE_THRESHOLD=5
# PROVIDER_COOLDOWN_SECONDS=60
# METRICS_ENABLED=false
# FORWARDED_ALLOW_IPS=127.0.0.1
# MVP model connections (M01/M11). Names only; never commit values.
# DEEPINFRA_API_KEY=
# OPENAI_API_KEY=
# Envelope encryption of stored model keys/tokens (M11): "id:base64url32" entries, comma separated;
# the last one is active unless CREDENTIALS_MASTER_KEY_ACTIVE names another. Required in
# staging/production. Generate one: python -c "from app.core.crypto import generate_master_key as g; print(g())"
# CREDENTIALS_MASTER_KEYS=
# CREDENTIALS_MASTER_KEY_ACTIVE=
# MODEL_REQUEST_TIMEOUT_SECONDS=60
# MODEL_STREAM_DEADLINE_SECONDS=120
# MODEL_USAGE_PAUSE_SECONDS=3600

# Run engine profiles (M12). Steps = model calls per run; ACK delay 0 disables speech.ack.
# RUN_VOICE_MAX_STEPS=3
# RUN_VOICE_MAX_TOOL_CALLS=2
# RUN_VOICE_MAX_PARALLEL_READS=4
# RUN_VOICE_TIMEOUT_SECONDS=25
# RUN_VOICE_SPEECH_MAX_CHARS=250
# RUN_VOICE_ACK_DELAY_MS=1500
# RUN_SPEECH_ACK_TEXT=Секунду.
# RUN_CHAT_MAX_STEPS=12
# RUN_CHAT_MAX_TOOL_CALLS=24
# RUN_CHAT_TIMEOUT_SECONDS=150
# RUN_JOB_MAX_STEPS=40
# RUN_JOB_MAX_TOOL_CALLS=80
# RUN_JOB_TIMEOUT_SECONDS=1800
# RUN_APP_MAX_STEPS=8
# RUN_APP_MAX_TOOL_CALLS=8
# RUN_APP_TIMEOUT_SECONDS=60
# RUN_CONTEXT_RECENT_ENTRIES=20
# RUN_FEED_SUMMARY_BATCH=20

# Tool router (M13). Remote MCP hosts must be in the plugin's permissions.network and, when
# set, in TOOLS_MCP_HOST_ALLOWLIST (comma separated). Private/metadata addresses are always refused.
# TOOLS_CALL_TIMEOUT_SECONDS=20
# TOOLS_LIST_TIMEOUT_SECONDS=8
# TOOLS_LIST_CACHE_SECONDS=60
# TOOLS_APPROVAL_TTL_SECONDS=120
# TOOLS_MAX_RESULT_CHARS=8000
# TOOLS_MCP_HOST_ALLOWLIST=

# Plugin store and connections (M15). PUBLIC_BASE_URL is the origin of this API (OAuth callback
# `<origin>/v1/connections/callback`); STORE_ADMIN_USER_IDS lists the users.id that may publish.
# PUBLIC_BASE_URL=http://localhost:8000
# STORE_ADMIN_USER_IDS=
# STORE_PACKAGES_DIR=
# CONNECTIONS_OAUTH_TIMEOUT_SECONDS=10
# CONNECTIONS_OAUTH_FLOW_TTL_SECONDS=600

# «Войти через Mia», OpenAI-compatible API and /mcp for apps (M50). The issuer and the consent
# page default to PUBLIC_BASE_URL and <PUBLIC_BASE_URL>/oauth.html. ID tokens are signed with a
# key derived from AUTH_JWT_SECRET. Spend without a provider price is estimated per 1M tokens.
# OAUTH_ISSUER=
# OAUTH_CONSENT_URL=
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
# OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# OAUTH_CODE_TTL_SECONDS=60
# OAUTH_REQUEST_TTL_SECONDS=600
# OAUTH_CIMD_TIMEOUT_SECONDS=5
# OAUTH_CIMD_CACHE_SECONDS=3600
# OAUTH_ALLOW_LOOPBACK_CLIENTS=false
# OAUTH_EXTRA_RESOURCES=
# OAUTH_PLUGIN_TOKEN_TTL_SECONDS=300
# APPS_DEFAULT_MONTHLY_LIMIT_USD=5
# APPS_MAX_MONTHLY_LIMIT_USD=100
# APPS_ESTIMATED_INPUT_USD_PER_MTOK=0.5
# APPS_ESTIMATED_OUTPUT_USD_PER_MTOK=2

# Jobs worker, schedules and push (M16). The worker runs as `python -m app.worker`.
# JOBS_WORKER_CONCURRENCY=4
# JOBS_POLL_SECONDS=1
# JOBS_LEASE_SECONDS=60
# JOBS_MAX_ATTEMPTS=3
# JOBS_RETRY_BASE_SECONDS=30
# JOBS_MAX_ACTIVE_PER_USER=10
# JOBS_MAX_SCHEDULES_PER_USER=25
# JOBS_MIN_SCHEDULE_INTERVAL_SECONDS=300
# JOBS_MISFIRE_GRACE_SECONDS=120
# JOBS_DEADLINE_SCAN_SECONDS=2
# JOBS_SHUTDOWN_GRACE_SECONDS=20
# NOTIFY_MAX_PER_HOUR=30
# NOTIFY_DELIVERY_MAX_ATTEMPTS=5
# FCM HTTP v1: project id and the path to a Firebase service-account JSON (never commit it).
# Without both, push deliveries end as skipped (push_not_configured).
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_FILE=
# FCM_ENDPOINT=https://fcm.googleapis.com
# FCM_TIMEOUT_SECONDS=10

# Telegram bot (M41): notifications to the user and the deep-link binding. Create the bot with
# BotFather; the webhook is `<PUBLIC_BASE_URL>/webhooks/telegram`, registered with
# `python -m app.modules.notifications.telegram_webhook set`. Without the token the bot is off.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
# TELEGRAM_LINK_TTL_SECONDS=900
